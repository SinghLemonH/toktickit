// ============================================================================
// LOCKED SCHEMA — Lab 2 (TokTickIT)
// Do not modify without updating docs/lab-02/specification.md Section 7 and
// getting reviewer sign-off. Every field/index below has a stated reason —
// if you think something's missing, add a new Assumption entry, don't just
// change this file mid-sprint.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// EXISTING FROM LAB 1 — extended, not replaced.
// Added: isActive. The handout's required API list explicitly says "retrieve
// active Categories", so Category needs an active flag exactly like
// RelatedSystem and DevRequester. Existing rows get isActive=true via the
// column default, so this is a non-breaking migration.
// ----------------------------------------------------------------------------
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// ----------------------------------------------------------------------------
// NEW MODELS FOR LAB 2
// ----------------------------------------------------------------------------

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// "Development Requester" per the handout — a stand-in for a real logged-in
// user until Lab 3 introduces authentication. Kept intentionally minimal
// (no password/role fields) so it's obviously not being used as real auth.
model DevRequester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

// Internal helper table for safe, race-free Ticket Number generation.
// Why not just "COUNT(*) + 1" on Ticket? Two concurrent create-ticket
// requests could both read the same count and generate a duplicate number.
// A single atomic UPDATE ... SET lastValue = lastValue + 1 RETURNING lastValue
// on one row is safe under Postgres MVCC row locking without extra code.
// One row per calendar year (matches the TKT-YYYY-NNNNNN format).
model TicketNumberCounter {
  year      Int @id
  lastValue Int @default(0)
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Full lifecycle enum declared now, even though Lab 2 only ever sets NEW.
// Reason: the illustrative screens in the handout (Figure 1's "In Progress",
// the My Tickets table's Open/In Progress/Resolved/Pending) already reveal
// the intended status set. Declaring it now means Lab 3+ workflow work adds
// *behavior*, not a schema migration that would touch every existing Ticket
// row's enum type.
enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
  CANCELLED
}

model Ticket {
  id          Int      @id @default(autoincrement())
  ticketNumber String  @unique // format TKT-YYYY-NNNNNN, backend-generated (BR-01)

  requesterId Int
  requester   DevRequester @relation(fields: [requesterId], references: [id])

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  relatedSystemId Int
  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  summary     String       // 5-120 chars, validated in application code (BR-17)
  description String       // 20-2000 chars, validated in application code (BR-18)

  requestedPriority Priority
  itPriority        Priority?     // null until IT Staff workflow (out of scope, Lab 2 always null)
  currentStatus     TicketStatus  @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  // Primary My Tickets query: WHERE requesterId = ? ORDER BY createdAt DESC.
  // Composite index lets Postgres satisfy the owner-scope + default-sort in
  // one index scan instead of a filter-then-sort.
  @@index([requesterId, createdAt])
  // Supports the Category filter (BR-13) and the Category.tickets relation.
  @@index([categoryId])
  // Supports the Related System filter.
  @@index([relatedSystemId])
  // Supports the Current Status filter.
  @@index([currentStatus])
}

model Attachment {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  originalFilename String
  storedFilename   String @unique // randomized on-disk name (BR-30)
  mimeType         String
  sizeBytes        Int

  uploadedAt DateTime  @default(now())
  removedAt      DateTime? // soft removal (BR-31)
  removalReason  String?   // required at the application layer when removedAt is set (BR-32)

  // Every Ticket Detail page load fetches this Ticket's attachments.
  @@index([ticketId])
}
